# App
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database
POSTGRES_DB=zhuqing
POSTGRES_USER=zhuqing
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://zhuqing:change-me-locally@db:5432/zhuqing

# Open-Meteo: free endpoints are non-commercial only.
# For commercial use, set usage=commercial and provide a paid API key.
OPEN_METEO_USAGE=non_commercial
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=
OPEN_METEO_SINGLE_RUNS_BASE_URL=
WEATHER_MODELS=ecmwf_ifs,ecmwf_ifs025,ecmwf_aifs025_single
FORECAST_DAYS=7
WEATHER_BATCH_SIZE=25
WEATHER_TIMEOUT_SECONDS=45
WEATHER_MAX_ATTEMPTS=5

# Geography
DATA_DIR=/app/data
GRID_SPACING_DEGREES=0.25
